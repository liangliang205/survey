# Production environment variables (copy to .env and adjust)

# Database (default: sqlite inside container). For production consider Postgres/MySQL.
DATABASE_URL=file:./prisma/prod.db

# Strong random secret: generate via `openssl rand -base64 32` (Linux/macOS)
NEXTAUTH_SECRET=replace_with_strong_random_secret

# Auth.js v5 preferred base URL (public HTTPS domain)
# Use AUTH_URL for v5; keep NEXTAUTH_URL for backward compatibility if needed.
AUTH_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# Trust proxy host header (set true if behind reverse proxy like Nginx/Caddy)
AUTH_TRUST_HOST=true

# Optional: service port inside container
PORT=3000
