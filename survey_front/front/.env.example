# Production environment variables (copy to .env and adjust)
# SQLite local file (inside container)
DATABASE_URL=file:./prisma/dev.db
# Strong random secret: generate via `openssl rand -hex 32`
NEXTAUTH_SECRET=replace_with_hex_secret
# Public base URL (HTTPS domain in production)
NEXTAUTH_URL=https://your-domain.com
# Optional: adjust port if behind reverse proxy
PORT=3000
