datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // Prisma 5 支持这种方式
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              Admin   @relation(fields: [userId], references: [id], onDelete: Cascade) // ✅ 添加这行
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  password     String
  name         String? // 显示名称
  role         String    @default("ADMIN") // SUPER_ADMIN, ADMIN
  loginVersion Int       @default(0) // 用于控制单点登录
  createdAt    DateTime  @default(now())
  accounts     Account[]
  surveys      Survey[]
}

model Survey {
  id          String   @id @default(cuid())
  title       String
  // 为不同页面分别设置背景
  bgImageCover     String?
  bgImageQuestions String?
  bgImageThanks    String?
  supportCardImage String?
  supportButtonText String? // 支持卡片按钮文字
  supportButtonUrl  String? // 支持卡片按钮跳转链接
  redirectUrl      String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime? // 软删除时间
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
  submissions Submission[]
  userInfoFields UserInfoField[] // 添加用户信息字段关联

  @@index([isActive])
}

// 用户信息字段定义模型
model UserInfoField {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String   // 字段标题，如"姓名"、"手机号"
  type        String   // 字段类型，如"text"、"email"、"phone"
  required    Boolean  @default(true)
  order       Int      @default(0)
  placeholder String?
  exampleImage String?
  createdAt   DateTime @default(now())

  @@index([surveyId])
}

model Question {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String
  type        String // radio, checkbox, text, rating, date
  exampleImage String?
  options     Option[]
  order       Int      @default(0)
  required    Boolean  @default(true)
  placeholder String?

  @@index([surveyId])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  order      Int      @default(0)

  @@index([questionId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  appName     String   @default("Mobile Survey System")
  appDesc     String   @default("Lightweight full-stack survey solution")
  appIcon     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Submission {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userInfo  String // JSON: { name, phone, email, department }
  createdAt DateTime @default(now())
  answers   Answer[]

  @@index([surveyId, createdAt])
}

model Answer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  value        String // 对于多选，value 是 JSON 字符串化后的数组

  @@index([submissionId])
  @@index([questionId])
}